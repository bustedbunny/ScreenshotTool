; Generated by CMake. Package the same staged payload as the portable ZIP.
#if Ver != EncodeVer(6, 7, 3)
  #error Packaging requires the pinned Inno Setup 6.7.3 compiler.
#endif
#ifndef SourceDir
  #define SourceDir "@CMAKE_CURRENT_SOURCE_DIR@/dist"
#endif
#ifndef AppVersion
  #define AppVersion "@PROJECT_VERSION@"
#endif

[Setup]
AppId=bustedbunny.ScreenshotTool
AppName=ScreenshotTool
AppVersion={#AppVersion}
AppPublisher=bustedbunny
AppPublisherURL=https://github.com/bustedbunny/ScreenshotTool
AppSupportURL=https://github.com/bustedbunny/ScreenshotTool/issues
AppUpdatesURL=https://github.com/bustedbunny/ScreenshotTool/releases
DefaultDirName={localappdata}\Programs\ScreenshotTool
DefaultGroupName=ScreenshotTool
DisableProgramGroupPage=yes
UsePreviousAppDir=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64os
ArchitecturesInstallIn64BitMode=x64os
MinVersion=10.0.22000
AppMutex=Local\ScreenshotTool-1C6860C8-243D-4F14-B85C-26E74508D8AA,Local\ScreenshotTool.UpdateOperation
SetupMutex=Local\ScreenshotTool.Setup
CloseApplications=no
RestartApplications=no
SetupIconFile=@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico
UninstallDisplayIcon={app}\ScreenshotTool.exe
UninstallDisplayName=ScreenshotTool
VersionInfoVersion={#AppVersion}.0
VersionInfoDescription=ScreenshotTool installer
OutputDir=@CMAKE_CURRENT_SOURCE_DIR@/release-assets
OutputBaseFilename=ScreenshotTool-{#AppVersion}-windows-x64-setup
Compression=lzma2
SolidCompression=yes
WizardStyle=modern

[Tasks]
Name: desktopicon; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "{#SourceDir}\ScreenshotTool.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}\README.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}\docs\*.md"; DestDir: "{app}\docs"; Flags: ignoreversion

[Icons]
Name: "{userprograms}\ScreenshotTool"; Filename: "{app}\ScreenshotTool.exe"; WorkingDir: "{app}"
Name: "{userdesktop}\ScreenshotTool"; Filename: "{app}\ScreenshotTool.exe"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{app}\ScreenshotTool.exe"; Description: "{cm:LaunchProgram,ScreenshotTool}"; Flags: nowait postinstall skipifsilent

[Code]
type
  HKEY = Longint;

const
  RunKey = 'Software\Microsoft\Windows\CurrentVersion\Run';
  RunValue = 'ScreenshotTool';
  AppMutexNames = 'Local\ScreenshotTool-1C6860C8-243D-4F14-B85C-26E74508D8AA,Local\ScreenshotTool.UpdateOperation';
  RegSz = 1;
  KeyQueryValue64 = $0101;

var
  PreviousSignInCommand: String;
  MigrateSignIn: Boolean;
  UninstallSetupMutex: Longint;

function RegOpenKeyExW(RootKey: HKEY; SubKey: String; Options, DesiredAccess: Cardinal;
  var OpenedKey: HKEY): Longint;
  external 'RegOpenKeyExW@advapi32.dll stdcall';
function RegQueryValueExW(Key: HKEY; ValueName: String; Reserved: Longint;
  var ValueType: Cardinal; Data: Longint; var DataSize: Cardinal): Longint;
  external 'RegQueryValueExW@advapi32.dll stdcall';
function RegCloseKey(Key: HKEY): Longint;
  external 'RegCloseKey@advapi32.dll stdcall';
{ Inno Setup 6 runs a 32-bit installer even when installing an x64 application. }
function CreateMutexW(SecurityAttributes: Longint; InitialOwner: Integer;
  Name: String): Longint;
  external 'CreateMutexW@kernel32.dll stdcall';
function CloseHandle(Handle: Longint): Boolean;
  external 'CloseHandle@kernel32.dll stdcall';

function ReadSignInCommand(var Command: String): Boolean;
var
  Key: HKEY;
  ValueType, DataSize: Cardinal;
begin
  Result := False;
  if RegOpenKeyExW(HKCU, RunKey, 0, KeyQueryValue64, Key) <> 0 then
    Exit;
  try
    DataSize := 0;
    if RegQueryValueExW(Key, RunValue, 0, ValueType, 0, DataSize) <> 0 then
      Exit;
    if ValueType <> RegSz then
      Exit;
    Result := RegQueryStringValue(HKCU64, RunKey, RunValue, Command);
  finally
    RegCloseKey(Key);
  end;
end;

function SignInExecutable(const Command: String; var Executable: String): Boolean;
var
  Value: String;
  VersionMS, VersionLS: Cardinal;
begin
  Result := False;
  Value := Trim(Command);
  if (Length(Value) >= 2) and (Value[1] = '"') and (Value[Length(Value)] = '"') then
    Value := Copy(Value, 2, Length(Value) - 2);
  { The app writes just its executable path. Preserve unrelated commands and arguments. }
  if (Pos('"', Value) <> 0) or (ExtractFileDrive(Value) = '') or
     (CompareText(ExtractFileName(Value), 'ScreenshotTool.exe') <> 0) then
    Exit;
  if FileExists(Value) then begin
    if not GetVersionNumbers(Value, VersionMS, VersionLS) then
      Exit;
  end;
  Executable := ExpandFileName(Value);
  Result := True;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  InstalledVersion, InstallerVersion: Int64;
  InstalledExe, ExistingCommand, ExistingExe: String;
begin
  Result := '';
  if CheckForMutexes(AppMutexNames) then begin
    Result := 'ScreenshotTool or an update is running. Exit ScreenshotTool from its tray menu and run Setup again after the update completes.';
    Exit;
  end;
  InstalledExe := ExpandConstant('{app}\ScreenshotTool.exe');
  if FileExists(InstalledExe) then begin
    if not GetPackedVersion(InstalledExe, InstalledVersion) then begin
      Result := 'Cannot read the installed ScreenshotTool version. Remove the damaged executable and run Setup again.';
      Exit;
    end;
    if not StrToVersion('{#AppVersion}.0', InstallerVersion) then begin
      Result := 'The installer has an invalid application version.';
      Exit;
    end;
    if ComparePackedVersion(InstalledVersion, InstallerVersion) > 0 then begin
      Result := 'A newer version of ScreenshotTool is already installed. Download the latest installer from GitHub releases.';
      Exit;
    end;
  end;
  MigrateSignIn := False;
  if ReadSignInCommand(ExistingCommand) and SignInExecutable(ExistingCommand, ExistingExe) then begin
    PreviousSignInCommand := ExistingCommand;
    MigrateSignIn := True;
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  CurrentCommand: String;
begin
  if (CurStep = ssPostInstall) and MigrateSignIn then begin
    { Recheck so installation never overwrites a preference changed in the meantime. }
    if ReadSignInCommand(CurrentCommand) and (CurrentCommand = PreviousSignInCommand) then
      if not RegWriteStringValue(HKCU64, RunKey, RunValue,
          '"' + ExpandConstant('{app}\ScreenshotTool.exe') + '"') then
        RaiseException('Cannot update the existing launch-at-sign-in preference.');
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  CurrentCommand, CurrentExe: String;
begin
  if CurUninstallStep = usUninstall then begin
    if CheckForMutexes(AppMutexNames) then
      RaiseException('ScreenshotTool or an update is running. Exit the app and wait for its update before uninstalling.');
    if ReadSignInCommand(CurrentCommand) and SignInExecutable(CurrentCommand, CurrentExe) then
      if CompareText(CurrentExe, ExpandConstant('{app}\ScreenshotTool.exe')) = 0 then
        if not RegDeleteValue(HKCU64, RunKey, RunValue) then
          RaiseException('Cannot remove this installation''s launch-at-sign-in preference.');
  end;
end;

function InitializeUninstall: Boolean;
var
  ErrorCode: Longint;
begin
  { Inno's SetupMutex covers Setup only. Hold the same mutex throughout uninstall. }
  UninstallSetupMutex := CreateMutexW(0, 0, 'Local\ScreenshotTool.Setup');
  ErrorCode := DLLGetLastError;
  Result := (UninstallSetupMutex <> 0) and (ErrorCode <> 183);
  if not Result then begin
    if UninstallSetupMutex <> 0 then begin
      CloseHandle(UninstallSetupMutex);
      UninstallSetupMutex := 0;
    end;
    SuppressibleMsgBox('ScreenshotTool Setup is already running. Close it before uninstalling.',
      mbError, MB_OK, IDOK);
  end;
end;

procedure DeinitializeUninstall;
begin
  if UninstallSetupMutex <> 0 then
    CloseHandle(UninstallSetupMutex);
end;
